{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{index.html,index_modular.html,css/**,js/**,models/**,dist/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
